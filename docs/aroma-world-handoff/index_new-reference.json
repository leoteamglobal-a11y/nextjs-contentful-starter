_tb": "15", "space_v_item_tb": "15", "space_h_item_mb": "10", "space_v_item_mb": "10", "layout_des": "2", "loop": true, "au_time": 0, "au_hover": true, "nav_btn": true, "btn_vi": "hover", "btn_owl": "default", "btn_shape": "none", "btn_cl": "dark", "btn_size": "small", "btn_hidden_mobile": false, "nav_dot": false, "dot_owl": "default", "dots_cl": "dark", "dots_round": true, "dots_space": 10, "dots_hidden_mobile": false, "layout": "t4s-container-wrap", "cl_bg": "#f5f0e6", "cl_bg_gradient": "", "mg": ",,20px,", "pd": "", "mg_tb": ",,20px,", "pd_tb": "", "mg_mb": ",,20px,", "pd_mb": ""}}, "custom_liquid_ejyAWC": {"type": "custom-liquid", "settings": {"custom_liquid": "<style>\n  .awq{background:#010C1C;color:#f4ead2;padding:64px 20px;font-family:'Lato',Helvetica,Arial,sans-serif;text-align:center;}\n  .awq *{box-sizing:border-box;}\n  .awq__eyebrow{color:#D9C562;letter-spacing:4px;text-transform:uppercase;font-size:13px;font-weight:700;margin:0 0 10px;}\n  .awq__title{font-family:'Playfair Display',Georgia,serif;font-size:38px;line-height:1.1;margin:0 0 10px;color:#fff;}\n  .awq__sub{color:#b9bcc4;font-size:16px;margin:0 auto 34px;max-width:560px;}\n  .awq__wrap{max-width:900px;margin:0 auto;}\n  .awq__view{display:none;}\n  .awq__view.is-active{display:block;animation:awqf .4s ease;}\n  @keyframes awqf{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}\n  .awq__entries{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}\n  .awq__entry{background:rgba(255,255,255,.04);border:1px solid rgba(217,197,98,.3);border-radius:16px;padding:36px 26px;text-align:center;}\n  .awq__eicon{font-size:40px;margin-bottom:12px;}\n  .awq__ename{font-family:'Playfair Display',Georgia,serif;font-size:23px;color:#fff;margin:0 0 8px;}\n  .awq__edesc{color:#aeb2bb;font-size:14px;margin:0 0 22px;}\n  .awq__q{display:none;}\n  .awq__q.is-active{display:block;animation:awqf .4s ease;}\n  .awq__qtitle{font-family:'Playfair Display',Georgia,serif;font-size:24px;color:#fff;margin:0 0 22px;}\n  .awq__opts{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}\n  .awq__opt{background:rgba(255,255,255,.04);border:1px solid rgba(217,197,98,.35);color:#f4ead2;border-radius:12px;padding:18px 18px;font-size:16px;cursor:pointer;transition:.2s;text-align:left;line-height:1.35;}\n  .awq__opt:hover{background:rgba(217,197,98,.14);border-color:#D9C562;transform:translateY(-2px);}\n  .awq__opt b{display:block;color:#fff;font-size:17px;margin-bottom:3px;}\n  .awq__opt span{color:#aeb2bb;font-size:13px;}\n  .awq__steps{color:#8a93a8;font-size:12px;letter-spacing:2px;text-transform:uppercase;margin-bottom:22px;}\n  .awq__card{background:#0b1730;border:1px solid rgba(217,197,98,.3);border-radius:16px;overflow:hidden;max-width:420px;margin:8px auto 22px;}\n  .awq__card img{width:100%;aspect-ratio:1;object-fit:cover;display:block;background:#0b1730;}\n  .awq__cbody{padding:20px 18px 24px;}\n  .awq__tag{color:#D9C562;font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700;}\n  .awq__cname{font-family:'Playfair Display',Georgia,serif;font-size:26px;color:#fff;margin:6px 0 4px;}\n  .awq__cdesc{color:#aeb2bb;font-size:14px;margin:0 0 18px;}\n  .awq__btn{display:inline-block;background:#D9C562;color:#010C1C;font-weight:700;text-decoration:none;padding:12px 30px;border-radius:8px;font-size:14px;letter-spacing:.5px;cursor:pointer;border:none;transition:.2s;}\n  .awq__btn:hover{filter:brightness(1.08);}\n  .awq__pet{background:rgba(217,197,98,.1);border:1px solid rgba(217,197,98,.3);border-radius:10px;padding:12px 16px;color:#f4ead2;font-size:13px;max-width:420px;margin:0 auto 18px;}\n  .awq__back{background:none;border:none;color:#8a93a8;text-decoration:underline;cursor:pointer;font-size:13px;margin-top:8px;}\n  @media(max-width:640px){.awq__entries{grid-template-columns:1fr;}.awq__opts{grid-template-columns:1fr;}.awq__title{font-size:30px;}}\n</style>\n\n<div class=\"awq\" id=\"awq\">\n  <div class=\"awq__wrap\">\n    <p class=\"awq__eyebrow\" data-en=\"Need help choosing?\" data-es=\"¿Necesitas ayuda para elegir?\"></p>\n    <h2 class=\"awq__title\" data-en=\"We'll help you find yours\" data-es=\"Te ayudamos a encontrar el tuyo\"></h2>\n    <p class=\"awq__sub\" data-en=\"Answer a few quick questions and we'll give you the perfect match.\" data-es=\"Responde unas preguntas rápidas y te damos la recomendación perfecta.\"></p>\n\n    <div class=\"awq__view is-active\" data-view=\"home\">\n      <div class=\"awq__entries\">\n        <div class=\"awq__entry\">\n          <div class=\"awq__eicon\">🌸</div>\n          <h3 class=\"awq__ename\" data-en=\"Not sure which scent to choose?\" data-es=\"¿No sabes qué aroma escoger?\"></h3>\n          <p class=\"awq__edesc\" data-en=\"Find the perfect fragrance for your style.\" data-es=\"Encuentra la fragancia ideal para tu estilo.\"></p>\n          <button class=\"awq__btn\" data-start=\"scent\" data-en=\"Find your scent\" data-es=\"Encuentra tu aroma\"></button>\n        </div>\n        <div class=\"awq__entry\">\n          <div class=\"awq__eicon\">🌀</div>\n          <h3 class=\"awq__ename\" data-en=\"Not sure which diffuser is best for you?\" data-es=\"¿No sabes qué difusor es mejor para ti?\"></h3>\n          <p class=\"awq__edesc\" data-en=\"Find the ideal diffuser for your space.\" data-es=\"Encuentra el difusor ideal para tu espacio.\"></p>\n          <button class=\"awq__btn\" data-start=\"dif\" data-en=\"Find your diffuser\" data-es=\"Encuentra tu difusor\"></button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"awq__view\" data-view=\"scent\">\n      <div class=\"awq__q is-active\" data-q=\"scent\">\n        <p class=\"awq__steps\" data-en=\"Scent quiz\" data-es=\"Quiz de aroma\"></p>\n        <h3 class=\"awq__qtitle\" data-en=\"What scent style do you prefer?\" data-es=\"¿Qué estilo de aroma prefieres?\"></h3>\n        <div class=\"awq__opts\">\n          <button class=\"awq__opt\" data-scent=\"dreamy\"><b data-en=\"Fresh & aquatic\" data-es=\"Fresco y acuático\"></b><span data-en=\"Citrus, sea breeze\" data-es=\"Cítricos, brisa marina\"></span></button>\n          <button class=\"awq__opt\" data-scent=\"enigma\"><b data-en=\"Green & herbal\" data-es=\"Verde y herbal\"></b><span data-en=\"Herbs, lily of the valley\" data-es=\"Hierbas, lirio del valle\"></span></button>\n          <button class=\"awq__opt\" data-scent=\"temptation\"><b data-en=\"Woody\" data-es=\"Amaderado\"></b><span data-en=\"Cardamom, incense, sandalwood\" data-es=\"Cardamomo, incienso, sándalo\"></span></button>\n          <button class=\"awq__opt\" data-scent=\"eleganza\"><b data-en=\"Fresh & elegant\" data-es=\"Fresco y elegante\"></b><span data-en=\"Citrus, freesia, leather\" data-es=\"Cítricos, fresia, cuero\"></span></button>\n          <button class=\"awq__opt\" data-scent=\"utopia\"><b data-en=\"Floral\" data-es=\"Floral\"></b><span data-en=\"Lily of the valley, clove\" data-es=\"Lirio del valle, clavo\"></span></button>\n        </div>\n        <button class=\"awq__back\" data-back=\"1\" data-en=\"← Back\" data-es=\"← Volver\"></button>\n      </div>\n      <div class=\"awq__q\" data-q=\"scent-result\">\n        <p class=\"awq__tag\" data-en=\"Your ideal scent\" data-es=\"Tu aroma ideal\"></p>\n        <div class=\"awq__card\">\n          <img id=\"awqScentImg\" alt=\"\">\n          <div class=\"awq__cbody\">\n            <h4 class=\"awq__cname\" id=\"awqScentName\"></h4>\n            <p class=\"awq__cdesc\" id=\"awqScentDesc\"></p>\n            <a class=\"awq__btn\" id=\"awqScentBtn\" href=\"#\" data-en=\"View scent\" data-es=\"Ver aroma\"></a>\n          </div>\n        </div>\n        <div class=\"awq__pet\" data-en=\"🐾 Pet-conscious: made without the essential oils flagged as toxic to pets · IFRA compliant.\" data-es=\"🐾 Pet-conscious: formulado sin los aceites señalados como tóxicos para mascotas · cumple IFRA.\"></div>\n        <button class=\"awq__back\" data-back=\"1\" data-en=\"← Start over\" data-es=\"← Empezar de nuevo\"></button>\n      </div>\n    </div>\n\n    <div class=\"awq__view\" data-view=\"dif\">\n      <div class=\"awq__q is-active\" data-q=\"dif\">\n        <p class=\"awq__steps\" data-en=\"Diffuser quiz\" data-es=\"Quiz de difusor\"></p>\n        <h3 class=\"awq__qtitle\" data-en=\"Where will you use it?\" data-es=\"¿Dónde lo vas a usar?\"></h3>\n        <div class=\"awq__opts\">\n          <button class=\"awq__opt\" data-dif=\"jet\"><b data-en=\"A bathroom, entryway or corner\" data-es=\"Un baño, entrada o rincón\"></b><span data-en=\"Small spaces · ~250 ft²\" data-es=\"Espacios pequeños · ~250 ft²\"></span></button>\n          <button class=\"awq__opt\" data-dif=\"mist\"><b data-en=\"My car or something portable\" data-es=\"Mi auto o algo portátil\"></b><span data-en=\"Car & small spaces\" data-es=\"Auto y espacios pequeños\"></span></button>\n          <button class=\"awq__opt\" data-dif=\"tower\"><b data-en=\"A living room or bedroom\" data-es=\"Una sala o recámara\"></b><span data-en=\"Up to ~900 ft²\" data-es=\"Hasta ~900 ft²\"></span></button>\n          <button class=\"awq__opt\" data-dif=\"sky\"><b data-en=\"A large hall, lobby or reception\" data-es=\"Un salón grande, lobby o recepción\"></b><span data-en=\"Elegant tower · ~7,500 ft²\" data-es=\"Torre elegante · ~7,500 ft²\"></span></button>\n          <button class=\"awq__opt\" data-dif=\"power\"><b data-en=\"Whole home via HVAC\" data-es=\"Toda la casa conectada al aire (HVAC)\"></b><span data-en=\"Office or business · ~7,000 ft²\" data-es=\"Oficina o comercio · ~7,000 ft²\"></span></button>\n        </div>\n        <button class=\"awq__back\" data-back=\"1\" data-en=\"← Back\" data-es=\"← Volver\"></button>\n      </div>\n      <div class=\"awq__q\" data-q=\"dif-result\">\n        <p class=\"awq__tag\" data-en=\"Your ideal diffuser\" data-es=\"Tu difusor ideal\"></p>\n        <div class=\"awq__card\">\n          <img id=\"awqDifImg\" alt=\"\">\n          <div class=\"awq__cbody\">\n            <h4 class=\"awq__cname\" id=\"awqDifName\"></h4>\n            <p class=\"awq__cdesc\" id=\"awqDifDesc\"></p>\n            <a class=\"awq__btn\" id=\"awqDifBtn\" href=\"#\" data-en=\"View diffuser\" data-es=\"Ver difusor\"></a>\n          </div>\n        </div>\n        <button class=\"awq__back\" data-back=\"1\" data-en=\"← Start over\" data-es=\"← Empezar de nuevo\"></button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var root=document.getElementById('awq');if(!root)return;\n  var L=((document.documentElement.lang||'').toLowerCase().indexOf('es')===0)?'es':'en';\n  // apply static translations\n  root.querySelectorAll('[data-en]').forEach(function(el){\n    var t=el.getAttribute('data-'+L)||el.getAttribute('data-en');\n    if(t!=null) el.textContent=t;\n  });\n  var CDN='https://cdn.shopify.com/s/files/1/0769/8294/4053/files/';\n  var DIF={\n    jet:{n:'Jet',en:'Plug-in · bathrooms & corners · ~250 ft²',es:'Plug-in · baños y rincones · ~250 ft²',u:'/products/scentjet-diffuser',i:'hf_20260811_151445_ae935807-30be-49a4-933c-6883c0a41b2f.png'},\n    mist:{n:'Mist',en:'Wireless · car & small spaces',es:'Inalámbrico · auto y espacios pequeños',u:'/products/aromamist-diffuser',i:'hf_20260811_151445_09eb8c3f-f730-4c37-9962-64d6bc912757.png'},\n    tower:{n:'Tower',en:'Tabletop · living room & bedroom · ~900 ft²',es:'De mesa · sala y recámara · ~900 ft²',u:'/products/towermist-diffuser',i:'hf_20260811_151445_a747b7fa-e4f5-4435-bbf6-0d272c529af5.png'},\n    sky:{n:'Sky Tower',en:'Floor tower · lobbies & halls · ~7,500 ft²',es:'Torre de piso · lobby y salones · ~7,500 ft²',u:'/products/sky-tower',i:'hf_20260811_151445_b493a51a-dfb4-429e-bce4-79e50b30bcc2.png'},\n    power:{n:'Power',en:'HVAC · home, office or business · ~7,000 ft²',es:'HVAC · casa, oficina o negocio · ~7,000 ft²',u:'/products/aromapower-diffuser',i:'hf_20260811_151445_d6fcc732-3d40-43c6-94c3-50a4181f5a68.png'}\n  };\n  var SC={\n    dreamy:{n:'Dreamy',en:'Aquatic-citrus floral',es:'Acuático-cítrico floral',u:'/products/dreamy-scent',i:'hf_20260811_145605_26ed1a2b-28de-4260-a34e-bfce48e0a9ef.png'},\n    enigma:{n:'Enigma',en:'Green-herbal floral',es:'Verde-herbal floral',u:'/products/enigma-scent',i:'hf_20260811_145804_b0821874-8cc6-4a44-96bd-33496d4dfaea.png'},\n    temptation:{n:'Temptation',en:'Woody-spicy (incense)',es:'Amaderado-especiado (incienso)',u:'/products/temptation-scent',i:'hf_20260811_145804_1aabfd0a-c26c-4403-8df0-06d4401920fd.png'},\n    eleganza:{n:'Eleganza',en:'Citrus-floral chypre',es:'Cítrico-floral chipre',u:'/products/eleganza',i:'hf_20260811_145804_61d3f250-89bc-49fb-803f-26854987dc05.png'},\n    utopia:{n:'Utopia',en:'Floral-spicy',es:'Floral-especiado',u:'/products/utopia-scent',i:'hf_20260811_145804_fd745920-818b-477d-a0b3-7a8c72286ce5.png'}\n  };\n  function showView(v){root.querySelectorAll('.awq__view').forEach(function(e){e.classList.remove('is-active');});root.querySelector('[data-view=\"'+v+'\"]').classList.add('is-active');}\n  function showQ(v,q){var view=root.querySelector('[data-view=\"'+v+'\"]');view.querySelectorAll('.awq__q').forEach(function(e){e.classList.remove('is-active');});view.querySelector('[data-q=\"'+q+'\"]').classList.add('is-active');}\n  root.querySelectorAll('[data-start]').forEach(function(b){b.addEventListener('click',function(){var v=b.dataset.start;showView(v);showQ(v,v);});});\n  root.querySelectorAll('[data-back]').forEach(function(b){b.addEventListener('click',function(){showView('home');showQ('scent','scent');showQ('dif','dif');});});\n  root.querySelectorAll('[data-scent]').forEach(function(b){b.addEventListener('click',function(){\n    var s=SC[b.dataset.scent];\n    root.querySelector('#awqScentImg').src=CDN+s.i;\n    root.querySelector('#awqScentName').textContent=s.n;\n    root.querySelector('#awqScentDesc').textContent=s[L]||s.en;\n    root.querySelector('#awqScentBtn').href=s.u;\n    showQ('scent','scent-result');\n  });});\n  root.querySelectorAll('[data-dif]').f