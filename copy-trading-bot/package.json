{
  "name": "copy-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain Solana wallet analyzer for copy trading — ranks wallets by profitability and copyability. Phase C→A of the copy trading bot.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "analyze": "node --loader ts-node/esm src/cli.ts",
    "analyze:demo": "node --loader ts-node/esm src/cli.ts --demo",
    "watch": "node --loader ts-node/esm src/watch.ts",
    "watch:once": "node --loader ts-node/esm src/watch.ts --once",
    "watch:demo": "node --loader ts-node/esm src/watch.ts --demo",
    "exec:demo": "node --loader ts-node/esm src/executor/demo.ts",
    "stop": "mkdir -p out && touch out/STOP && echo 'Kill switch ON (out/STOP). Delete it to resume.'",
    "resume": "rm -f out/STOP && echo 'Kill switch OFF.'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
