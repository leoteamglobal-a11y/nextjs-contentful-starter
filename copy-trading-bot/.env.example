# === Copy Trading Bot — Wallet Analyzer config ===
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# Helius API key — used to read parsed swap history from Solana.
# Get a free key at https://dashboard.helius.dev  (free tier is enough to start)
HELIUS_API_KEY=

# How many recent transactions to scan per wallet (max 100 per Helius page).
# The analyzer paginates up to ANALYZE_TX_LIMIT total.
ANALYZE_TX_LIMIT=500

# Only count trades from the last N days (0 = no time filter, use all fetched tx).
ANALYZE_LOOKBACK_DAYS=30

# Minimum quote-asset value (in SOL) for a swap to count as a "real" trade.
# Filters out dust. e.g. 0.05 ignores trades smaller than ~0.05 SOL.
ANALYZE_MIN_TRADE_SOL=0.05

# === Monitor (Phase C) — Telegram alerts ===
# Create a bot with @BotFather to get the token; get your chat id from @userinfobot.
# Leave blank to run in console-only mode (alerts print to the terminal).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often (seconds) the watcher polls each wallet for new swaps.
WATCH_POLL_SECONDS=60

# Anti-chase controls. Defaults alert on NEW entries + EXITs only.
# ALERT_ON_ADDS=true would also alert when a trader buys more of a runner they
# already hold — usually a LATE/chase entry, so it's off by default.
ALERT_ON_ADDS=false
ALERT_ON_EXITS=true

# === Executor (Phase A) — autonomous trading ===
# off  = never trade (monitor/alerts only)
# dry  = autonomous PAPER trading — the bot decides and "fills" with fake money [DEFAULT]
# live = REAL swaps with REAL funds. Requires WALLET_PRIVATE_KEY + RPC_URL below.
#        ⚠️ Only switch to live AFTER watching dry-run behave for a while.
EXECUTION_MODE=dry

# LIVE only — a base58 private key of a DEDICATED wallet with limited funds.
# NEVER use your main wallet. NEVER commit this. Treat it like a password.
WALLET_PRIVATE_KEY=
RPC_URL=

# Position sizing
SIZING_MODE=fixed          # 'fixed' = FIXED_SIZE_SOL per trade; 'proportional' = % of bankroll
FIXED_SIZE_SOL=0.1
BANKROLL_SOL=1             # your total capital (for proportional sizing + sanity)
PROPORTIONAL_PCT=0.02      # 2% of bankroll per trade (proportional mode)

# Hard risk limits — the guardrails (apply in BOTH dry and live)
MAX_TRADE_SOL=0.25         # never spend more than this on one trade
DAILY_CAP_SOL=1            # never spend more than this total per day
MAX_TRADES_PER_DAY=20
MAX_SLIPPAGE_BPS=100       # 100 = 1% max slippage; reject the swap above it

# Kill switch: run `npm run stop` (creates out/STOP) to halt trading instantly.
# `npm run resume` removes it.
