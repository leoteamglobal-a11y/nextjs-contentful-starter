# === Copy Trading Bot — Wallet Analyzer config ===
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# Helius API key — used to read parsed swap history from Solana.
# Get a free key at https://dashboard.helius.dev  (free tier is enough to start)
HELIUS_API_KEY=

# How many recent transactions to scan per wallet (max 100 per Helius page).
# The analyzer paginates up to ANALYZE_TX_LIMIT total.
ANALYZE_TX_LIMIT=500

# Only count trades from the last N days (0 = no time filter, use all fetched tx).
ANALYZE_LOOKBACK_DAYS=30

# Minimum quote-asset value (in SOL) for a swap to count as a "real" trade.
# Filters out dust. e.g. 0.05 ignores trades smaller than ~0.05 SOL.
ANALYZE_MIN_TRADE_SOL=0.05
